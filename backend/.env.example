PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tasks_db
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_QUEUE=task_events
WORKER_MAX_RETRIES=3
WORKER_FAILURE_SIMULATION_ENABLED=false
WORKER_FAILURE_KEYWORD=[fail-worker]

# Optional Datadog APM overrides
DD_SERVICE=three-tier-backend
DD_ENV=development
DD_VERSION=1.0.0
DD_LOGS_INJECTION=true
